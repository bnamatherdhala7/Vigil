# Keep Vercel from auto-deploying Python source as serverless functions.
# The api/ directory in particular is Vercel-special — files there
# become serverless functions unless we exclude them.

# Python source trees
api/
phase1_mcp/
phase2_5_classifier/
phase2_agent/
phase3_evaluator/
vigil/
tests/
demo/
scripts/
data/

# Python files anywhere
*.py
*.ipynb
*.pyc
*.pyo
__pycache__/

# Python project config — triggers Python auto-detection
pyproject.toml
requirements.txt
setup.py
setup.cfg
